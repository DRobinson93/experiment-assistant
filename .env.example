# Copy this file to .env.local and fill it in. .env.local is ignored by git.

# Which model service answers: ollama (local, free), anthropic (hosted, paid) or mock (scripted, for tests).
PROVIDER=ollama

# Only for PROVIDER=ollama.
OLLAMA_MODEL=qwen3:8b

# Only for PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
